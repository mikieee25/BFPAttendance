# Core application
SECRET_KEY=replace-with-strong-random-secret
DATABASE_URL=mysql+pymysql://root:password@localhost/bfp_sorsogon_attendance

# Optional bootstrap admin (for fresh databases)
AUTO_CREATE_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@bfp.gov.ph
DEFAULT_ADMIN_PASSWORD=change-me

# Face recognition settings
USE_INSIGHTFACE=false
PRELOAD_FACE_MODELS=true
DEFAULT_STATION_PASSWORD=station123

# Optional runtime overrides (otherwise app defaults are used)
# FACE_DETECTION_CONFIDENCE=0.3
# FACE_RECOGNITION_THRESHOLD=0.35
# WORK_START_TIME=08:00
# ATTENDANCE_COOLDOWN=5
# LIVENESS_MIN_FRAMES=3
